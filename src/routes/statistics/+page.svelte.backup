<script>
	import Header from '$lib/components/Header.svelte';
	import Footer from '$lib/components/Footer.svelte';
	
	export let data;
	
	const stats = data?.stats || null;
	const quarterPealStats = data?.quarterPealStats || null;
	const pealStats = data?.pealStats || null;
	const otherStats = data?.otherStats || null;
	
	let activeSection = 'quarters'; // 'quarters', 'peals', or 'other'
	let hoveredSlice = null;
	
	function setActiveSection(section) {
		activeSection = section;
	}
	
	// Calculate percentages for pie chart
	$: totalQP = quarterPealStats?.count || 0;
	$: totalPeals = pealStats?.count || 0;
	$: totalOther = otherStats?.count || 0;
	$: totalPerformances = totalQP + totalPeals + totalOther;
	
	$: qpPercent = totalPerformances > 0 ? (totalQP / totalPerformances * 100) : 0;
	$: pealPercent = totalPerformances > 0 ? (totalPeals / totalPerformances * 100) : 0;
	$: otherPercent = totalPerformances > 0 ? (totalOther / totalPerformances * 100) : 0;
	
	// Helper function to create pie slice path
	function getSlicePath(startAngle, endAngle, radius = 90) {
		const x1 = 100 + radius * Math.cos(startAngle * Math.PI / 180);
		const y1 = 100 + radius * Math.sin(startAngle * Math.PI / 180);
		const x2 = 100 + radius * Math.cos(endAngle * Math.PI / 180);
		const y2 = 100 + radius * Math.sin(endAngle * Math.PI / 180);
		const largeArc = endAngle - startAngle > 180 ? 1 : 0;
		
		return `M 100 100 L ${x1} ${y1} A ${radius} ${radius} 0 ${largeArc} 1 ${x2} ${y2} Z`;
	}
	
	$: qpEndAngle = qpPercent * 3.6;
	$: pealEndAngle = qpEndAngle + (pealPercent * 3.6);
	
	// Format date
	function formatDate(dateStr) {
		if (!dateStr) return 'Unknown date';
		const date = new Date(dateStr);
		return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
	}
	
	// Format weight
	function formatWeight(weight) {
		if (!weight) return 'Unknown';
		return `${weight}`;
	}
</script>

<svelte:head>
	<title>My Statistics | towertracker</title>
</svelte:head>

<Header user={data.user} />

<main class="section">
	<div class="container">
		<div class="columns is-centered">
			<div class="column is-two-thirds">
				<h1 class="title">My Statistics</h1>
				
				{#if data.error}
					<div class="notification is-danger">
						<p>{data.error}</p>
					</div>
				{:else if stats}
					<div class="box">
						<!-- Pie Chart -->
						{#if totalPerformances > 0}
							<div class="chart-container">
								<svg viewBox="0 0 200 200" class="pie-chart" aria-label="Performance distribution chart">
									<!-- Quarter Peals slice -->
									{#if qpPercent > 0}
										<path
											d={getSlicePath(0, qpEndAngle)}
											fill="#48c78e"
											class="pie-slice clickable"
											class:hovered={hoveredSlice === 'quarters'}
											on:click={() => setActiveSection('quarters')}
											on:mouseenter={() => hoveredSlice = 'quarters'}
											on:mouseleave={() => hoveredSlice = null}
											on:keypress={(e) => e.key === 'Enter' && setActiveSection('quarters')}
											role="button"
											tabindex="0"
											aria-label="Quarter peals section"
										/>
									{/if}
									<!-- Peals slice -->
									{#if pealPercent > 0}
										<path
											d={getSlicePath(qpEndAngle, pealEndAngle)}
											fill="#3e8ed0"
											class="pie-slice clickable"
											class:hovered={hoveredSlice === 'peals'}
											on:click={() => setActiveSection('peals')}
											on:mouseenter={() => hoveredSlice = 'peals'}
											on:mouseleave={() => hoveredSlice = null}
											on:keypress={(e) => e.key === 'Enter' && setActiveSection('peals')}
											role="button"
											tabindex="0"
											aria-label="Peals section"
										/>
									{/if}
									<!-- Other slice -->
									{#if otherPercent > 0}
										<path
											d={getSlicePath(pealEndAngle, 360)}
											fill="#ffe08a"
											class="pie-slice clickable"
											class:hovered={hoveredSlice === 'other'}
											on:click={() => setActiveSection('other')}
											on:mouseenter={() => hoveredSlice = 'other'}
											on:mouseleave={() => hoveredSlice = null}
											on:keypress={(e) => e.key === 'Enter' && setActiveSection('other')}
											role="button"
											tabindex="0"
											aria-label="Other performances section"
										/>
									{/if}
								</svg>
								<div class="mt-4">
									<div class="is-flex is-align-items-center mb-2">
										<span class="legend-color mr-2" style="background: #48c78e;"></span>
										<span class="is-size-7">Quarter Peals ({qpPercent.toFixed(1)}%)</span>
									</div>
									<div class="is-flex is-align-items-center mb-2">
										<span class="legend-color mr-2" style="background: #3e8ed0;"></span>
										<span class="is-size-7">Peals ({pealPercent.toFixed(1)}%)</span>
									</div>
									<div class="is-flex is-align-items-center">
										<span class="legend-color mr-2" style="background: #ffe08a;"></span>
										<span class="is-size-7">Other ({otherPercent.toFixed(1)}%)</span>
									</div>
								</div>
							</div>
						{:else}
							<div class="has-text-centered py-5">
								<p class="has-text-grey">No performance data available.</p>
							</div>
						{/if}
						
						<!-- Toggle Buttons -->
						<div class="buttons has-addons is-centered mt-5">
							<button 
								class="button {activeSection === 'quarters' ? 'is-success is-selected' : ''}"
								on:click={() => setActiveSection('quarters')}
							>
								Quarter Peals
							</button>
							<button 
								class="button {activeSection === 'peals' ? 'is-info is-selected' : ''}"
								on:click={() => setActiveSection('peals')}
							>
								Peals
							</button>
							<button 
								class="button {activeSection === 'other' ? 'is-warning is-selected' : ''}"
								on:click={() => setActiveSection('other')}
							>
								Other
							</button>
						</div>
						
						<!-- Details Section -->
						<div class="mt-4">
							{#if activeSection === 'quarters'}
								<h4 class="subtitle is-5">Quarter Peal Highlights</h4>
								{#if quarterPealStats && quarterPealStats.count > 0}
									<div class="content">
										<p><strong>Total:</strong> {quarterPealStats.count}</p>
										
										<ul class="statistics-list">
											{#if quarterPealStats.heaviestBell}
												<li>
													<strong>Heaviest Bell:</strong> {formatWeight(quarterPealStats.heaviestBell.weight)} ({quarterPealStats.heaviestBell.weightPounds} lbs)
													<br>
													<a href="/bellboard/performance?id={quarterPealStats.heaviestBell.performanceId}" class="is-size-7">
														{quarterPealStats.heaviestBell.place} • {formatDate(quarterPealStats.heaviestBell.date)}
													</a>
												</li>
											{/if}
											
											{#if quarterPealStats.longestDuration}
												<li>
													<strong>Longest Duration:</strong> {quarterPealStats.longestDuration.duration} ({quarterPealStats.longestDuration.durationMinutes} mins)
													<br>
													<a href="/bellboard/performance?id={quarterPealStats.longestDuration.performanceId}" class="is-size-7">
														{quarterPealStats.longestDuration.place} • {formatDate(quarterPealStats.longestDuration.date)}
													</a>
												</li>
											{/if}
											
											{#if quarterPealStats.mostChanges}
												<li>
													<strong>Most Changes:</strong> {quarterPealStats.mostChanges.changes}
													<br>
													<a href="/bellboard/performance?id={quarterPealStats.mostChanges.performanceId}" class="is-size-7">
														{quarterPealStats.mostChanges.place} • {formatDate(quarterPealStats.mostChanges.date)}
													</a>
												</li>
											{/if}
										</ul>
									</div>
								{:else}
									<p class="has-text-grey">No quarter peals found.</p>
								{/if}
								
							{:else if activeSection === 'peals'}
								<h4 class="subtitle is-5">Peal Highlights</h4>
								{#if pealStats && pealStats.count > 0}
									<div class="content">
										<p><strong>Total:</strong> {pealStats.count}</p>
										
										<ul class="statistics-list">
											{#if pealStats.heaviestBell}
												<li>
													<strong>Heaviest Bell:</strong> {formatWeight(pealStats.heaviestBell.weight)} ({pealStats.heaviestBell.weightPounds} lbs)
													<br>
													<a href="/bellboard/performance?id={pealStats.heaviestBell.performanceId}" class="is-size-7">
														{pealStats.heaviestBell.place} • {formatDate(pealStats.heaviestBell.date)}
													</a>
												</li>
											{/if}
											
											{#if pealStats.longestDuration}
												<li>
													<strong>Longest Duration:</strong> {pealStats.longestDuration.duration} ({pealStats.longestDuration.durationMinutes} mins)
													<br>
													<a href="/bellboard/performance?id={pealStats.longestDuration.performanceId}" class="is-size-7">
														{pealStats.longestDuration.place} • {formatDate(pealStats.longestDuration.date)}
													</a>
												</li>
											{/if}
											
											{#if pealStats.mostChanges}
												<li>
													<strong>Most Changes:</strong> {pealStats.mostChanges.changes}
													<br>
													<a href="/bellboard/performance?id={pealStats.mostChanges.performanceId}" class="is-size-7">
														{pealStats.mostChanges.place} • {formatDate(pealStats.mostChanges.date)}
													</a>
												</li>
											{/if}
										</ul>
									</div>
								{:else}
									<p class="has-text-grey">No peals found.</p>
								{/if}
								
							{:else}
								<h4 class="subtitle is-5">Other Performance Highlights</h4>
								{#if otherStats && otherStats.count > 0}
									<div class="content">
										<p><strong>Total:</strong> {otherStats.count}</p>
										
										<ul class="statistics-list">
											{#if otherStats.heaviestBell}
												<li>
													<strong>Heaviest Bell:</strong> {formatWeight(otherStats.heaviestBell.weight)} ({otherStats.heaviestBell.weightPounds} lbs)
													<br>
													<a href="/bellboard/performance?id={otherStats.heaviestBell.performanceId}" class="is-size-7">
														{otherStats.heaviestBell.place} • {formatDate(otherStats.heaviestBell.date)}
													</a>
												</li>
											{/if}
											
											{#if otherStats.longestDuration}
												<li>
													<strong>Longest Duration:</strong> {otherStats.longestDuration.duration} ({otherStats.longestDuration.durationMinutes} mins)
													<br>
													<a href="/bellboard/performance?id={otherStats.longestDuration.performanceId}" class="is-size-7">
														{otherStats.longestDuration.place} • {formatDate(otherStats.longestDuration.date)}
													</a>
												</li>
											{/if}
											
											{#if otherStats.mostChanges}
												<li>
													<strong>Most Changes:</strong> {otherStats.mostChanges.changes}
													<br>
													<a href="/bellboard/performance?id={otherStats.mostChanges.performanceId}" class="is-size-7">
														{otherStats.mostChanges.place} • {formatDate(otherStats.mostChanges.date)}
													</a>
												</li>
											{/if}
										</ul>
									</div>
								{:else}
									<p class="has-text-grey">No other performances found.</p>
								{/if}
							{/if}
						</div>
					</div>
				{:else}
					<div class="notification is-info">
						<p>No statistics available.</p>
					</div>
				{/if}
			</div>
		</div>
	</div>
</main>

<Footer />

<style>
	.chart-container {
		max-width: 250px;
		margin: 1.5rem auto;
	}

	.pie-chart {
		width: 100%;
		height: auto;
		display: block;
	}

	.pie-slice.clickable {
		cursor: pointer;
		transition: transform 0.2s, opacity 0.2s;
		transform-origin: center;
	}

	.pie-slice.clickable:hover,
	.pie-slice.clickable.hovered {
		opacity: 0.85;
		transform: scale(1.05);
	}

	.pie-slice.clickable:focus {
		outline: 3px solid #4a4a4a;
		outline-offset: 3px;
	}

	.legend-color {
		width: 20px;
		height: 20px;
		border-radius: 4px;
		flex-shrink: 0;
	}
	
	.statistics-list {
		list-style: none;
		padding-left: 0;
	}
	
	.statistics-list li {
		padding: 0.75rem 0;
		border-bottom: 1px solid #f5f5f5;
	}
	
	.statistics-list li:last-child {
		border-bottom: none;
	}
	
	.statistics-list a {
		color: #3273dc;
		text-decoration: none;
	}
	
	.statistics-list a:hover {
		text-decoration: underline;
	}
</style>
	<div class="container">
		<div class="columns is-centered">
			<div class="column is-four-fifths">
				<h1 class="title">My Statistics</h1>
				
				{#if data.error}
					<div class="notification is-danger">
						<p>{data.error}</p>
					</div>
				{:else if stats}
					<!-- Overall Summary -->
					<div class="box">
						<h2 class="title is-4">Overall Summary</h2>
						<div class="columns is-multiline">
							<div class="column is-one-third">
								<div class="has-text-centered">
									<p class="heading">Total Performances</p>
									<p class="title is-3">{stats.performanceCount || 0}</p>
								</div>
							</div>
							<div class="column is-one-third">
								<div class="has-text-centered">
									<p class="heading">Quarter Peals</p>
									<p class="title is-3">{stats.quarterCount || 0}</p>
								</div>
							</div>
							<div class="column is-one-third">
								<div class="has-text-centered">
									<p class="heading">Peals</p>
									<p class="title is-3">{stats.pealCount || 0}</p>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Quarter Peals -->
					<div class="box">
						<h2 class="title is-4">Quarter Peal Statistics</h2>
						{#if quarterPealStats && quarterPealStats.count > 0}
							<div class="content">
								<p><strong>Total Quarter Peals:</strong> {quarterPealStats.count}</p>
								
								{#if quarterPealStats.heaviestBell}
									<div class="mt-4">
										<h3 class="subtitle is-5">Heaviest Bell Rung</h3>
										<div class="box">
											<p><strong>Weight:</strong> {formatWeight(quarterPealStats.heaviestBell.weight)} ({quarterPealStats.heaviestBell.weightPounds} lbs)</p>
											<p><strong>Location:</strong> {quarterPealStats.heaviestBell.place}, {quarterPealStats.heaviestBell.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {quarterPealStats.heaviestBell.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(quarterPealStats.heaviestBell.date)}</p>
											{#if quarterPealStats.heaviestBell.title}
												<p><strong>Title:</strong> {quarterPealStats.heaviestBell.title}</p>
											{/if}
										</div>
									</div>
								{/if}
								
								{#if quarterPealStats.longestDuration}
									<div class="mt-4">
										<h3 class="subtitle is-5">Longest Duration</h3>
										<div class="box">
											<p><strong>Duration:</strong> {formatDuration(quarterPealStats.longestDuration.duration)} ({quarterPealStats.longestDuration.durationMinutes} minutes)</p>
											<p><strong>Changes:</strong> {quarterPealStats.longestDuration.changes}</p>
											<p><strong>Location:</strong> {quarterPealStats.longestDuration.place}, {quarterPealStats.longestDuration.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {quarterPealStats.longestDuration.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(quarterPealStats.longestDuration.date)}</p>
											{#if quarterPealStats.longestDuration.title}
												<p><strong>Title:</strong> {quarterPealStats.longestDuration.title}</p>
											{/if}
										</div>
									</div>
								{/if}
								
								{#if quarterPealStats.mostChanges}
									<div class="mt-4">
										<h3 class="subtitle is-5">Most Changes</h3>
										<div class="box">
											<p><strong>Changes:</strong> {quarterPealStats.mostChanges.changes}</p>
											<p><strong>Duration:</strong> {formatDuration(quarterPealStats.mostChanges.duration)}</p>
											<p><strong>Location:</strong> {quarterPealStats.mostChanges.place}, {quarterPealStats.mostChanges.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {quarterPealStats.mostChanges.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(quarterPealStats.mostChanges.date)}</p>
											{#if quarterPealStats.mostChanges.title}
												<p><strong>Title:</strong> {quarterPealStats.mostChanges.title}</p>
											{/if}
										</div>
									</div>
								{/if}
							</div>
						{:else}
							<p class="has-text-grey">No quarter peals found.</p>
						{/if}
					</div>
					
					<!-- Peals -->
					<div class="box">
						<h2 class="title is-4">Peal Statistics</h2>
						{#if pealStats && pealStats.count > 0}
							<div class="content">
								<p><strong>Total Peals:</strong> {pealStats.count}</p>
								
								{#if pealStats.heaviestBell}
									<div class="mt-4">
										<h3 class="subtitle is-5">Heaviest Bell Rung</h3>
										<div class="box">
											<p><strong>Weight:</strong> {formatWeight(pealStats.heaviestBell.weight)} ({pealStats.heaviestBell.weightPounds} lbs)</p>
											<p><strong>Location:</strong> {pealStats.heaviestBell.place}, {pealStats.heaviestBell.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {pealStats.heaviestBell.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(pealStats.heaviestBell.date)}</p>
											{#if pealStats.heaviestBell.title}
												<p><strong>Title:</strong> {pealStats.heaviestBell.title}</p>
											{/if}
										</div>
									</div>
								{/if}
								
								{#if pealStats.longestDuration}
									<div class="mt-4">
										<h3 class="subtitle is-5">Longest Duration</h3>
										<div class="box">
											<p><strong>Duration:</strong> {formatDuration(pealStats.longestDuration.duration)} ({pealStats.longestDuration.durationMinutes} minutes)</p>
											<p><strong>Changes:</strong> {pealStats.longestDuration.changes}</p>
											<p><strong>Location:</strong> {pealStats.longestDuration.place}, {pealStats.longestDuration.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {pealStats.longestDuration.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(pealStats.longestDuration.date)}</p>
											{#if pealStats.longestDuration.title}
												<p><strong>Title:</strong> {pealStats.longestDuration.title}</p>
											{/if}
										</div>
									</div>
								{/if}
								
								{#if pealStats.mostChanges}
									<div class="mt-4">
										<h3 class="subtitle is-5">Most Changes</h3>
										<div class="box">
											<p><strong>Changes:</strong> {pealStats.mostChanges.changes}</p>
											<p><strong>Duration:</strong> {formatDuration(pealStats.mostChanges.duration)}</p>
											<p><strong>Location:</strong> {pealStats.mostChanges.place}, {pealStats.mostChanges.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {pealStats.mostChanges.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(pealStats.mostChanges.date)}</p>
											{#if pealStats.mostChanges.title}
												<p><strong>Title:</strong> {pealStats.mostChanges.title}</p>
											{/if}
										</div>
									</div>
								{/if}
							</div>
						{:else}
							<p class="has-text-grey">No peals found.</p>
						{/if}
					</div>
					
					<!-- Other (720s, Half Peals) -->
					<div class="box">
						<h2 class="title is-4">Other Performances (720s, Half Peals)</h2>
						{#if otherStats && otherStats.count > 0}
							<div class="content">
								<p><strong>Total Performances:</strong> {otherStats.count}</p>
								
								{#if otherStats.heaviestBell}
									<div class="mt-4">
										<h3 class="subtitle is-5">Heaviest Bell Rung</h3>
										<div class="box">
											<p><strong>Weight:</strong> {formatWeight(otherStats.heaviestBell.weight)} ({otherStats.heaviestBell.weightPounds} lbs)</p>
											<p><strong>Location:</strong> {otherStats.heaviestBell.place}, {otherStats.heaviestBell.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {otherStats.heaviestBell.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(otherStats.heaviestBell.date)}</p>
											{#if otherStats.heaviestBell.title}
												<p><strong>Title:</strong> {otherStats.heaviestBell.title}</p>
											{/if}
										</div>
									</div>
								{/if}
								
								{#if otherStats.longestDuration}
									<div class="mt-4">
										<h3 class="subtitle is-5">Longest Duration</h3>
										<div class="box">
											<p><strong>Duration:</strong> {formatDuration(otherStats.longestDuration.duration)} ({otherStats.longestDuration.durationMinutes} minutes)</p>
											<p><strong>Changes:</strong> {otherStats.longestDuration.changes}</p>
											<p><strong>Location:</strong> {otherStats.longestDuration.place}, {otherStats.longestDuration.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {otherStats.longestDuration.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(otherStats.longestDuration.date)}</p>
											{#if otherStats.longestDuration.title}
												<p><strong>Title:</strong> {otherStats.longestDuration.title}</p>
											{/if}
										</div>
									</div>
								{/if}
								
								{#if otherStats.mostChanges}
									<div class="mt-4">
										<h3 class="subtitle is-5">Most Changes</h3>
										<div class="box">
											<p><strong>Changes:</strong> {otherStats.mostChanges.changes}</p>
											<p><strong>Duration:</strong> {formatDuration(otherStats.mostChanges.duration)}</p>
											<p><strong>Location:</strong> {otherStats.mostChanges.place}, {otherStats.mostChanges.dedicn || 'Unknown'}</p>
											<p><strong>County:</strong> {otherStats.mostChanges.county || 'Unknown'}</p>
											<p><strong>Date:</strong> {formatDate(otherStats.mostChanges.date)}</p>
											{#if otherStats.mostChanges.title}
												<p><strong>Title:</strong> {otherStats.mostChanges.title}</p>
											{/if}
										</div>
									</div>
								{/if}
							</div>
						{:else}
							<p class="has-text-grey">No other performances found.</p>
						{/if}
					</div>
				{:else}
					<div class="notification is-info">
						<p>No statistics available.</p>
					</div>
				{/if}
			</div>
		</div>
	</div>
</main>

<Footer />
